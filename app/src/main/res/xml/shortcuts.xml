<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- B83: Direct Share — top of share sheet. 3 recent peers -->
    <share-target android:targetClass="com.garickbox.atom.ShareTargetActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.garickbox.atom.share_target" />
    </share-target>
    <shortcut
        android:shortcutId="shortcut_find"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_find_short"
        android:shortcutLongLabel="@string/shortcut_find_long">
        <intent
            android:action="com.garickbox.atom.SHORTCUT_FIND"
            android:targetPackage="com.garickbox.atom"
            android:targetClass="com.garickbox.atom.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_receive"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_recv_short"
        android:shortcutLongLabel="@string/shortcut_recv_long">
        <intent
            android:action="com.garickbox.atom.SHORTCUT_RECEIVE"
            android:targetPackage="com.garickbox.atom"
            android:targetClass="com.garickbox.atom.ShortcutActivity" />
    </shortcut>
</shortcuts>
